targetLab = 'Tulane';

if iscell(ExtractionLabs) || isstring(ExtractionLabs)
    mask = strcmp(cellstr(ExtractionLabs), targetLab);
else
    mask = ExtractionLabs == targetLab;
end

% Initialize
figure;
hold on

% Plot the saturation curve uncertainty region
