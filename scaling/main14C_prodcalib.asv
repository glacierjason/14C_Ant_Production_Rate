% Add text for the isobars 
text(4.2, 3100, '2ka', 'FontSize', 24, 'FontWeight','normal','FontName','Helvetica');
text(7.4, 3100, '4ka', 'FontSize', 24, 'FontWeight','normal','FontName','Helvetica');
